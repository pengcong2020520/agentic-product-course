# 复制为 .env，并由当前 shell 加载；Python 脚本读取环境变量。
# 备用预标接口使用 Kimi 的 API key。
KIMI_API_KEY=replace-with-your-kimi-api-key

# Argilla 服务地址；远程部署时改为实际地址。
ARGILLA_API_URL=http://localhost:6900
# 客户端与本地 compose 服务使用同一个 API key。
ARGILLA_API_KEY=replace-with-your-argilla-api-key
# 本地 compose 的登录名和密码；启动前替换占位值。
ARGILLA_USERNAME=replace-with-your-username
ARGILLA_PASSWORD=replace-with-your-password
